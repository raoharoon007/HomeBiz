# ==============================================================================
# HomeBiz Pakistan & Australia - Frontend Environment Variables (.env.example)
# ==============================================================================
# WARNING: NEVER commit real secret keys, service_role keys, or backend credentials here.
# Only client-safe public keys prefixed with VITE_ are permitted in frontend code.

# 1. Supabase Public Client Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-public-anon-key

# NOTE: SUPABASE_SERVICE_ROLE_KEY MUST NEVER BE EXPOSED IN FRONTEND CODE OR VITE_ VARS.
# Service-role operations must only run in secure server-side Edge Functions or server APIs.

# 2. Application Base URL
VITE_APP_URL=https://your-domain.com

# 3. EmailJS Public Configuration (For client-side notification dispatch)
VITE_EMAILJS_SERVICE_ID=service_your_service_id
VITE_EMAILJS_TEMPLATE_ID=template_your_welcome_template
VITE_EMAILJS_OTP_TEMPLATE_ID=template_your_otp_template
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# 4. Optional PayPal Client ID (Client-side Sandbox/Live Publishable Client ID)
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id
